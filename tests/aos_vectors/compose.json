{
  "description": "Resolution and composition. 'overlays' maps identity to manifest; 'files' lists an overlay's files where skills are discovered. 'expect' gives the visiting order, the composition order and what the active overlays contribute, or the cycle; with 'facts', the environment they build together.",
  "spec": "spec/v0/composition.md",
  "cases": [
    {
      "id": "order-priority-name",
      "description": "Ascending (priority, name, identity); requires does not change the order.",
      "overlays": {
        "engineering": {
          "name": "engineering",
          "routing": [
            "- eng"
          ]
        },
        "python": {
          "requires": [
            "engineering"
          ],
          "routing": [
            "- py"
          ],
          "priority": 300
        },
        "team": {
          "name": "Alpha",
          "priority": 700,
          "routing": [
            "- team"
          ],
          "context": [
            "CONTEXT.md"
          ]
        },
        "zeta": {
          "name": "",
          "routing": [
            "- zeta"
          ]
        }
      },
      "requested": [
        "team",
        "python",
        "zeta"
      ],
      "expect": {
        "install_order": [
          "team",
          "engineering",
          "python",
          "zeta"
        ],
        "active": [
          "python",
          "engineering",
          "zeta",
          "team"
        ],
        "missing": [],
        "root_variables": {
          "python": "PYTHON_OVERLAY_ROOT",
          "engineering": "ENGINEERING_OVERLAY_ROOT",
          "zeta": "ZETA_OVERLAY_ROOT",
          "team": "TEAM_OVERLAY_ROOT"
        },
        "routing": [
          "- py",
          "- eng",
          "- zeta",
          "- team"
        ],
        "rules": [],
        "context": [
          [
            "team",
            "CONTEXT.md"
          ]
        ],
        "skills": {},
        "skill_collisions": []
      }
    },
    {
      "id": "name-tiebreak-code-points",
      "description": "Names compare by code point: 'B' (42) sorts before 'a' (61); equal names fall back to identity.",
      "overlays": {
        "one": {
          "name": "a"
        },
        "two": {
          "name": "B"
        },
        "three": {
          "name": "a"
        }
      },
      "requested": [
        "one",
        "two",
        "three"
      ],
      "expect": {
        "install_order": [
          "one",
          "two",
          "three"
        ],
        "active": [
          "two",
          "one",
          "three"
        ],
        "missing": [],
        "root_variables": {
          "two": "TWO_OVERLAY_ROOT",
          "one": "ONE_OVERLAY_ROOT",
          "three": "THREE_OVERLAY_ROOT"
        },
        "routing": [],
        "rules": [],
        "context": [],
        "skills": {},
        "skill_collisions": []
      }
    },
    {
      "id": "name-scalar-order",
      "description": "Names compare by Unicode scalar value: U+FFFD before U+1F600, the reverse of UTF-16 code units.",
      "overlays": {
        "emoji": {
          "name": "😀"
        },
        "replacement": {
          "name": "�"
        }
      },
      "requested": [
        "emoji",
        "replacement"
      ],
      "expect": {
        "install_order": [
          "emoji",
          "replacement"
        ],
        "active": [
          "replacement",
          "emoji"
        ],
        "missing": [],
        "root_variables": {
          "replacement": "REPLACEMENT_OVERLAY_ROOT",
          "emoji": "EMOJI_OVERLAY_ROOT"
        },
        "routing": [],
        "rules": [],
        "context": [],
        "skills": {},
        "skill_collisions": []
      }
    },
    {
      "id": "requires-normalized",
      "description": "Requirements are normalized; each overlay is active once.",
      "overlays": {
        "team-review": {
          "requires": [
            "Engineering_Base"
          ]
        },
        "engineering-base": {},
        "other": {
          "requires": [
            "team.review"
          ]
        }
      },
      "requested": [
        "other",
        "team-review"
      ],
      "expect": {
        "install_order": [
          "engineering-base",
          "team-review",
          "other"
        ],
        "active": [
          "engineering-base",
          "other",
          "team-review"
        ],
        "missing": [],
        "root_variables": {
          "engineering-base": "ENGINEERING_BASE_OVERLAY_ROOT",
          "other": "OTHER_OVERLAY_ROOT",
          "team-review": "TEAM_REVIEW_OVERLAY_ROOT"
        },
        "routing": [],
        "rules": [],
        "context": [],
        "skills": {},
        "skill_collisions": []
      }
    },
    {
      "id": "missing",
      "description": "A requirement no source offers is reported with the overlay that requires it.",
      "overlays": {
        "rust": {
          "requires": [
            "engineering",
            "toolchain"
          ]
        },
        "engineering": {}
      },
      "requested": [
        "rust",
        "absent"
      ],
      "expect": {
        "install_order": [
          "engineering",
          "rust"
        ],
        "active": [
          "engineering",
          "rust"
        ],
        "missing": [
          [
            "rust",
            "toolchain"
          ],
          [
            "",
            "absent"
          ]
        ],
        "root_variables": {
          "engineering": "ENGINEERING_OVERLAY_ROOT",
          "rust": "RUST_OVERLAY_ROOT"
        },
        "routing": [],
