        "skill_collisions": []
      }
    },
    {
      "id": "cycle",
      "description": "A cycle is an error naming the chain.",
      "overlays": {
        "a": {
          "requires": [
            "b"
          ]
        },
        "b": {
          "requires": [
            "c"
          ]
        },
        "c": {
          "requires": [
            "a"
          ]
        }
      },
      "requested": [
        "a"
      ],
      "expect": {
        "error": "cycle",
        "chain": [
          "a",
          "b",
          "c",
          "a"
        ]
      }
    },
    {
      "id": "self-cycle",
      "description": "An overlay that requires itself.",
      "overlays": {
        "a": {
          "requires": [
            "a"
          ]
        }
      },
      "requested": [
        "a"
      ],
      "expect": {
        "error": "cycle",
        "chain": [
          "a",
          "a"
        ]
      }
    },
    {
      "id": "skills",
      "description": "Declared skills, discovered skills, and collisions (names compare without ASCII case) won by the overlay later in order.",
      "overlays": {
        "base": {
          "priority": 100
        },
        "docs": {
          "skills": [
            "search",
            "Lint"
          ],
          "priority": 600
        },
        "extra": {
          "skills": []
        }
      },
      "requested": [
        "base",
        "docs",
        "extra"
      ],
      "files": {
        "base": [
          "skills/search/SKILL.md",
          "skills/lint/SKILL.md",
          "skills/README.md"
        ],
        "docs": [
          "skills/search/SKILL.md",
          "skills/Lint/SKILL.md"
        ],
        "extra": [
          "skills/hidden/SKILL.md"
        ]
      },
      "expect": {
        "install_order": [
          "base",
          "docs",
          "extra"
        ],
        "active": [
          "base",
          "extra",
          "docs"
        ],
        "missing": [],
        "root_variables": {
          "base": "BASE_OVERLAY_ROOT",
          "extra": "EXTRA_OVERLAY_ROOT",
          "docs": "DOCS_OVERLAY_ROOT"
        },
        "routing": [],
        "rules": [],
        "context": [],
        "skills": {
          "Lint": "docs",
          "search": "docs"
        },
        "skill_collisions": [
          "lint",
          "search"
        ]
      }
    },
    {
      "id": "env-across-overlays",
      "description": "Root variables first; then each overlay's env and paths in order: the later overlay wins and its prepends come first.",
      "overlays": {
        "low": {
          "priority": 100,
          "env": {
            "MODE": "low",
            "ONLY_LOW": "1"
          },
          "paths": [
            {
              "variable": "PATH",
              "path": "bin"
            }
          ]
        },
        "high": {
          "priority": 900,
          "env": {
            "MODE": "high",
            "LOW_ROOT_SEEN": {
              "value": "x",
              "if_unset": true
            }
          },
          "paths": [
            {
              "variable": "PATH",
              "path": "bin"
            },
            {
              "variable": "PATH",
              "path": "tools",
              "position": "append"
            }
          ]
        }
      },
      "requested": [
        "high",
        "low"
      ],
      "facts": {
        "os": "linux",
        "base_env": {
          "PATH": "/usr/bin:/bin"
        },
        "roots": {
          "low": "/ov/low",
          "high": "/ov/high"
        }
      },
      "expect": {
        "active": [
          "low",
          "high"
        ],
        "env": {
          "PATH": "/ov/high/bin:/ov/low/bin:/usr/bin:/bin:/ov/high/tools",
          "LOW_OVERLAY_ROOT": "/ov/low",
          "HIGH_OVERLAY_ROOT": "/ov/high",
          "MODE": "high",
          "ONLY_LOW": "1",
          "LOW_ROOT_SEEN": "x"
        }
      }
    },
    {
      "id": "env-across-overlays-windows",
      "description": "The same on Windows: ';', backslashes, and names without regard to case.",
      "overlays": {
        "low": {
          "priority": 100,
          "env": {
            "MODE": "low"
          },
          "paths": [
            {
              "variable": "PATH",
              "path": "bin"
            }
          ]
        },
        "high": {
          "priority": 900,
          "env": {
            "mode": "high"
          },
          "paths": [
            {
              "variable": "Path",
              "path": "bin"
            }
          ]
        }
      },
      "requested": [
        "low",
        "high"
      ],
      "facts": {
        "os": "windows",
        "base_env": {
          "Path": "C:\\Windows;C:\\Windows\\System32"
        },
        "roots": {
          "low": "C:\\ov\\low",
          "high": "C:\\ov\\high"
        }
      },
      "expect": {
        "active": [
          "low",
          "high"
        ],
        "env": {
          "Path": "C:\\ov\\high\\bin;C:\\ov\\low\\bin;C:\\Windows;C:\\Windows\\System32",
          "LOW_OVERLAY_ROOT": "C:\\ov\\low",
          "HIGH_OVERLAY_ROOT": "C:\\ov\\high",
          "MODE": "high"
        }
      }
    }
  ]
}
