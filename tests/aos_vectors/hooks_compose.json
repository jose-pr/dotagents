{
  "description": "(Hook cases only, filtered from the specification's compose.json by an id starting env-pre-env.) Resolution and composition. 'overlays' maps identity to manifest; 'files' lists an overlay's files, from which the fields a manifest does not write take their defaults (skills, rules, context, paths). A 'files' entry may instead map each path to its text, for the files read as env files. 'expect' gives the visiting order, the composition order and what the active overlays contribute, or the cycle; with 'facts', the environment they build together, or the refusal. 'facts' may give 'packages' (per identity, each runtime's installed packages directory) and 'removed' (overlays being removed); a case that states 'environments' also expects the dependency environments (runtime, environment, overlays in composition order, files, locked), the 'conflicts' (runtime, environment, package, overlays), the overlays 'blocked' by them (not activated, absent from 'active' and the environment), and what each removed overlay 'left' ('rebuilt' or 'deleted').",
  "spec": "spec/v0/composition.md",
  "cases": [
    {
      "id": "env-pre-env-before-every-overlay",
      "description": "pre-env applies after the root variables and before any overlay's declarations, so an overlay earlier in composition order reads what a later one's pre-env set.",
      "overlays": {
        "low": {
          "priority": 100,
          "env": {
            "SEEN": "${FROM_HIGH:-none}"
          }
        },
        "high": {
          "priority": 900
        }
      },
      "requested": [
        "high",
        "low"
      ],
      "facts": {
        "os": "linux",
        "base_env": {},
        "roots": {
          "low": "/ov/low",
          "high": "/ov/high"
        },
        "pre_env": {
          "high": {
            "stdout": "{\"FROM_HIGH\": \"yes\"}"
          }
        }
      },
      "expect": {
        "active": [
          "low",
          "high"
        ],
        "env": {
          "LOW_OVERLAY_ROOT": "/ov/low",
          "HIGH_OVERLAY_ROOT": "/ov/high",
          "FROM_HIGH": "yes",
          "SEEN": "yes"
        },
        "hook_reports": [],
        "hook_non_defaults": []
      }
    },
    {
      "id": "env-pre-env-composition-order",
      "description": "Every overlay's pre-env in composition order: the later one's value replaces the earlier one's.",
      "overlays": {
        "low": {
          "priority": 100
        },
        "high": {
          "priority": 900
        }
      },
      "requested": [
        "high",
        "low"
      ],
      "facts": {
        "os": "linux",
        "base_env": {},
        "roots": {
          "low": "/ov/low",
          "high": "/ov/high"
        },
        "pre_env": {
          "low": {
            "stdout": "{\"MODE\": \"low\"}"
          },
          "high": {
            "stdout": "{\"MODE\": \"high\"}"
          }
        }
      },
      "expect": {
        "active": [
          "low",
          "high"
        ],
        "env": {
          "LOW_OVERLAY_ROOT": "/ov/low",
          "HIGH_OVERLAY_ROOT": "/ov/high",
          "MODE": "high"
        },
        "hook_reports": [],
        "hook_non_defaults": []
      }
    },
    {
      "id": "env-pre-env-then-env",
      "description": "An overlay's own env comes after every pre-env, and replaces what one set.",
      "overlays": {
        "low": {
          "priority": 100,
          "env": {
            "MODE": "declared"
          }
        },
        "high": {
          "priority": 900
        }
      },
      "requested": [
        "high",
        "low"
      ],
      "facts": {
        "os": "linux",
        "base_env": {},
        "roots": {
          "low": "/ov/low",
          "high": "/ov/high"
        },
        "pre_env": {
          "high": {
            "stdout": "{\"MODE\": \"hook\"}"
          }
        }
      },
      "expect": {
        "active": [
          "low",
          "high"
        ],
        "env": {
          "LOW_OVERLAY_ROOT": "/ov/low",
          "HIGH_OVERLAY_ROOT": "/ov/high",
          "MODE": "declared"
        },
        "hook_reports": [],
        "hook_non_defaults": []
      }
    },
    {
      "id": "env-pre-env-sees-roots",
      "description": "A pre-env hook's output is what it printed: nothing in it is substituted, and the roots were set before it ran.",
      "overlays": {
        "low": {
          "priority": 100
        }
      },
      "requested": [
        "low"
      ],
      "facts": {
        "os": "linux",
        "base_env": {},
        "roots": {
          "low": "/ov/low"
        },
        "pre_env": {
          "low": {
            "stdout": "{\"RAW\": \"${LOW_OVERLAY_ROOT}\"}"
          }
        }
      },
      "expect": {
        "active": [
          "low"
        ],
        "env": {
          "LOW_OVERLAY_ROOT": "/ov/low",
          "RAW": "${LOW_OVERLAY_ROOT}"
        },
        "hook_reports": [],
        "hook_non_defaults": []
      }
    },
    {
      "id": "env-pre-env-lines",
      "description": "The output is an env script's: one object per line, applied in order, null unsetting.",
      "overlays": {
        "low": {
          "priority": 100
        }
      },
      "requested": [
        "low"
      ],
      "facts": {
        "os": "linux",
        "base_env": {
          "OLD": "1",
          "KEEP": "1"
        },
        "roots": {
          "low": "/ov/low"
        },
        "pre_env": {
          "low": {
            "stdout": "{\"A\": \"1\", \"OLD\": \"2\"}\n{\"OLD\": null}\n"
          }
        }
      },
      "expect": {
        "active": [
          "low"
        ],
        "env": {
          "KEEP": "1",
          "LOW_OVERLAY_ROOT": "/ov/low",
          "A": "1"
        },
        "hook_reports": [],
        "hook_non_defaults": []
      }
    },
    {
      "id": "env-pre-env-failed-report",
      "description": "A failed pre-env hook applies nothing, is reported, and the session goes on.",
      "overlays": {
        "low": {
          "priority": 100,
          "env": {
            "MODE": "${HOOKED:-no}"
          }
        }
      },
      "requested": [
        "low"
      ],
      "facts": {
        "os": "linux",
        "base_env": {},
        "roots": {
          "low": "/ov/low"
        },
        "pre_env": {
          "low": {
            "exit": 1,
            "stdout": "{\"HOOKED\": \"yes\"}"
          }
        }
      },
      "expect": {
        "active": [
          "low"
        ],
        "env": {
          "LOW_OVERLAY_ROOT": "/ov/low",
          "MODE": "no"
        },
        "hook_reports": [
          [
            "hook-failed",
            "low",
            "pre-env",
            "exit"
          ]
        ],
        "hook_non_defaults": []
      }
    },
    {
      "id": "env-pre-env-reserved",
      "description": "A pre-env hook that sets another overlay's root fails as an env script would, and applies nothing.",
      "overlays": {
        "low": {
          "priority": 100
        },
        "high": {
          "priority": 900
        }
      },
      "requested": [
        "high",
        "low"
      ],
      "facts": {
        "os": "linux",
        "base_env": {},
        "roots": {
          "low": "/ov/low",
          "high": "/ov/high"
        },
        "pre_env": {
          "high": {
            "stdout": "{\"LOW_OVERLAY_ROOT\": \"/tmp/evil\", \"OK\": \"1\"}"
          }
        }
      },
      "expect": {
        "active": [
          "low",
          "high"
        ],
        "env": {
          "LOW_OVERLAY_ROOT": "/ov/low",
          "HIGH_OVERLAY_ROOT": "/ov/high"
        },
        "hook_reports": [
          [
            "hook-failed",
            "high",
            "pre-env",
            "output"
          ]
        ],
        "hook_non_defaults": []
      }
    },
    {
      "id": "env-pre-env-refuse",
      "description": "With on_failure = refuse, a failed pre-env hook refuses the session: no environment is built and the harness is not started.",
      "overlays": {
        "low": {
          "priority": 100
        }
      },
      "requested": [
        "low"
      ],
      "facts": {
        "os": "linux",
        "base_env": {},
        "roots": {
          "low": "/ov/low"
        },
        "pre_env": {
          "low": {
            "timed_out": true,
            "on_failure": "refuse",
            "stdout": ""
          }
        }
      },
      "expect": {
        "active": [
          "low"
        ],
        "env": {
          "error": "hook-refused",
          "subject": "low"
        },
        "hook_reports": [
          [
            "hook-failed",
            "low",
            "pre-env",
            "timeout"
          ]
        ],
        "hook_non_defaults": []
      }
    },
    {
      "id": "env-pre-env-sensitive",
      "description": "A sensitive variable a pre-env hook sets is reported as env-sensitive.",
      "overlays": {
        "low": {
          "priority": 100
        }
      },
      "requested": [
        "low"
      ],
      "facts": {
        "os": "linux",
        "base_env": {
          "PATH": "/usr/bin"
        },
        "roots": {
          "low": "/ov/low"
        },
        "pre_env": {
          "low": {
            "stdout": "{\"PATH\": \"/opt/low/bin:/usr/bin\", \"CODEX_HOME\": \"/ov/low/codex\"}"
          }
        }
      },
      "expect": {
        "active": [
          "low"
        ],
        "env": {
          "PATH": "/opt/low/bin:/usr/bin",
          "LOW_OVERLAY_ROOT": "/ov/low",
          "CODEX_HOME": "/ov/low/codex"
        },
        "hook_reports": [],
        "hook_non_defaults": [
          [
            "env-sensitive",
            "CODEX_HOME"
          ],
          [
            "env-sensitive",
            "PATH"
          ]
        ]
      }
    },
    {
      "id": "env-pre-env-grant-is-a-variable",
      "description": "pre-env takes only variables: a 'decision' key is a variable name there, and grants nothing.",
      "overlays": {
        "low": {
          "priority": 100
        }
      },
      "requested": [
        "low"
      ],
      "facts": {
        "os": "linux",
        "base_env": {},
        "roots": {
          "low": "/ov/low"
        },
        "pre_env": {
          "low": {
            "stdout": "{\"decision\": \"allow\"}"
          }
        }
      },
      "expect": {
        "active": [
          "low"
        ],
        "env": {
          "LOW_OVERLAY_ROOT": "/ov/low",
          "decision": "allow"
        },
        "hook_reports": [],
        "hook_non_defaults": []
      }
    }
  ]
}
