{
  "description": "Reading documents: format selection, the data model, static reading, limits, and the dotenv grammar. Input is 'text' (UTF-8) or 'base64'; 'format' is 'aos' (overlay.cfg rules) or 'dotenv'. 'expect' is the data, or an error class (a list when either class is right); with both 'data' and 'error', either outcome is right.",
  "spec": "spec/v0/manifest.md#reading-overlaycfg",
  "cases": [
    {
      "id": "toml-default",
      "description": "No format line: TOML.",
      "format": "aos",
      "text": "name = \"x\"\n",
      "expect": {
        "data": {
          "name": "x"
        }
      }
    },
    {
      "id": "empty",
      "description": "An empty document is the empty mapping.",
      "format": "aos",
      "text": "",
      "expect": {
        "data": {}
      }
    },
    {
      "id": "blank",
      "description": "Only spaces, tabs and line breaks: the empty mapping.",
      "format": "aos",
      "text": " \n\t\r\n",
      "expect": {
        "data": {}
      }
    },
    {
      "id": "comment-only",
      "description": "A TOML comment line is not a format line.",
      "format": "aos",
      "text": "# notes\n",
      "expect": {
        "data": {}
      }
    },
    {
      "id": "bom-toml",
      "description": "One byte-order mark is dropped.",
      "format": "aos",
      "text": "﻿name = \"x\"\n",
      "expect": {
        "data": {
          "name": "x"
        }
      }
    },
    {
      "id": "bom-twice",
      "description": "Only one byte-order mark is dropped; the second reaches the TOML parser.",
      "format": "aos",
      "text": "﻿﻿name = \"x\"\n",
      "expect": {
        "error": "parse-error"
      }
    },
    {
      "id": "line-toml",
      "description": "#!toml names TOML; the line is removed.",
      "format": "aos",
      "text": "#!toml\nname = \"x\"\n",
      "expect": {
        "data": {
          "name": "x"
        }
      }
    },
    {
      "id": "line-case",
      "description": "The name ignores ASCII case.",
      "format": "aos",
      "text": "#!TOML\nname = \"x\"\n",
      "expect": {
        "data": {
          "name": "x"
        }
      }
    },
    {
      "id": "line-dots",
      "description": "Leading dots are dropped.",
      "format": "aos",
      "text": "#!.toml\nname = \"x\"\n",
      "expect": {
        "data": {
          "name": "x"
        }
      }
    },
    {
      "id": "line-env",
      "description": "The last word, after any '/', names the format.",
      "format": "aos",
      "text": "#!/usr/bin/env toml\nname = \"x\"\n",
      "expect": {
        "data": {
          "name": "x"
        }
      }
    },
    {
      "id": "line-backslash",
      "description": "After any '\\' too.",
      "format": "aos",
      "text": "#!C:\\tools\\json\n{\"name\": \"x\"}\n",
      "expect": {
        "data": {
          "name": "x"
        }
      }
    },
    {
      "id": "line-crlf",
      "description": "A CR before the LF is whitespace.",
      "format": "aos",
      "text": "#!json\r\n{\"name\": \"x\"}\r\n",
      "expect": {
        "data": {
          "name": "x"
        }
      }
    },
    {
      "id": "line-spaces",
      "description": "Spaces and tabs around the word.",
      "format": "aos",
      "text": "#!  \t yaml  \nname: x\n",
      "expect": {
        "data": {
          "name": "x"
        }
      }
    },
    {
      "id": "line-env-flags",
      "description": "Only the last word counts.",
      "format": "aos",
      "text": "#!/usr/bin/env -S yaml\nname: x\n",
      "expect": {
        "data": {
          "name": "x"
        }
      }
    },
    {
      "id": "bom-then-line",
      "description": "A byte-order mark before the format line.",
      "format": "aos",
      "text": "﻿#!json\n{\"name\": \"x\"}\n",
      "expect": {
        "data": {
          "name": "x"
        }
      }
    },
    {
      "id": "line-alone",
      "description": "A format line and nothing else: the empty mapping.",
      "format": "aos",
      "text": "#!json",
      "expect": {
        "data": {}
      }
    },
    {
      "id": "line-empty",
      "description": "'#!' names nothing.",
      "format": "aos",
      "text": "#!\nname = 'x'\n",
      "expect": {
        "error": "no-format-named"
      }
    },
    {
      "id": "line-blank",
      "description": "'#!' and whitespace names nothing.",
      "format": "aos",
      "text": "#!   \t\nname = 'x'\n",
      "expect": {
        "error": "no-format-named"
      }
    },
    {
      "id": "line-unsupported",
      "description": "A format the reader does not support is refused by name, never guessed.",
      "format": "aos",
      "text": "#!ini\nname=x\n",
      "expect": {
        "error": "unsupported-format"
      }
    },
    {
      "id": "line-unsupported-shown",
      "description": "A word that is not a plain name is not echoed.",
      "format": "aos",
      "text": "#!/bin/a$b\nx\n",
      "expect": {
        "error": "unsupported-format"
      }
    },
    {
      "id": "json-without-line",
      "description": "JSON without a format line is read as TOML, and fails.",
      "format": "aos",
      "text": "{\"name\": \"x\"}\n",
      "expect": {
        "error": "parse-error"
      }
    },
    {
      "id": "yaml-without-line",
      "description": "YAML without a format line is read as TOML, and fails.",
      "format": "aos",
      "text": "name: x\n",
      "expect": {
        "error": "parse-error"
      }
    },
    {
      "id": "yaml-directive-without-line",
      "description": "A %YAML directive does not select YAML.",
      "format": "aos",
      "text": "%YAML 1.2\n---\nname: x\n",
      "expect": {
        "error": "parse-error"
      }
    },
    {
      "id": "invalid-utf8",
      "description": "Invalid UTF-8.",
      "format": "aos",
      "base64": "bmFtZSA9ICL/Igo=",
      "expect": {
        "error": "invalid-utf8"
      }
    },
    {
      "id": "same-toml",
      "description": "One manifest in TOML ...",
      "format": "aos",
      "text": "name = \"same\"\npriority = 420\nrequires = [\"engineering\"]\n[env]\nMODE = \"read-only\"\n",
      "expect": {
        "data": {
          "name": "same",
          "priority": 420,
          "requires": [
            "engineering"
          ],
          "env": {
            "MODE": "read-only"
          }
        }
      }
    },
    {
      "id": "same-json",
      "description": "... in JSON ...",
      "format": "aos",
      "text": "#!json\n{\"name\": \"same\", \"priority\": 420, \"requires\": [\"engineering\"], \"env\": {\"MODE\": \"read-only\"}}\n",
      "expect": {
        "data": {
          "name": "same",
          "priority": 420,
          "requires": [
            "engineering"
          ],
          "env": {
            "MODE": "read-only"
          }
        }
      }
    },
    {
      "id": "same-yaml",
      "description": "... and in YAML read the same.",
      "format": "aos",
      "text": "#!yaml\nname: same\npriority: 420\nrequires: [engineering]\nenv:\n  MODE: read-only\n",
      "expect": {
        "data": {
          "name": "same",
          "priority": 420,
          "requires": [
            "engineering"
          ],
          "env": {
            "MODE": "read-only"
          }
        }
      }
    },
    {
      "id": "json-int-float",
      "description": "JSON: 30 is an integer, 30.0 and 3e1 are floats.",
      "format": "aos",
      "text": "#!json\n{\"a\": 30, \"b\": 30.0, \"c\": 3e1}\n",
      "expect": {
        "data": {
          "a": 30,
          "b": 30.0,
          "c": 30.0
        }
      }
    },
    {
      "id": "toml-int-float",
      "description": "TOML: 30 is an integer, 30.0 a float.",
      "format": "aos",
      "text": "a = 30\nb = 30.0\n",
      "expect": {
        "data": {
          "a": 30,
          "b": 30.0
        }
      }
    },
    {
      "id": "json-null",
      "description": "A null is refused.",
      "format": "aos",
      "text": "#!json\n{\"name\": null}\n",
      "expect": {
        "error": "null-value"
      }
    },
    {
      "id": "json-null-unknown-key",
      "description": "A null is refused in a key AOS does not define too.",
      "format": "aos",
      "text": "#!json\n{\"x_extension\": {\"a\": [1, null]}}\n",
      "expect": {
        "error": "null-value"
      }
    },
    {
      "id": "json-duplicate",
      "description": "A duplicate JSON key is refused.",
      "format": "aos",
      "text": "#!json\n{\"name\": \"a\", \"name\": \"b\"}\n",
      "expect": {
        "error": "duplicate-key"
      }
    },
    {
      "id": "json-nan",
      "description": "NaN is not JSON.",
      "format": "aos",
      "text": "#!json\n{\"a\": NaN}\n",
      "expect": {
        "error": "parse-error"
      }
    },
    {
      "id": "json-comment",
      "description": "Comments are not JSON.",
      "format": "aos",
      "text": "#!json\n{\"a\": 1 /* no */}\n",
      "expect": {
        "error": "parse-error"
      }
    },
    {
      "id": "json-huge-float",
      "description": "A float that overflows is not finite.",
      "format": "aos",
      "text": "#!json\n{\"a\": 1e400}\n",
      "expect": {
        "error": "non-finite-float"
      }
    },
    {
      "id": "json-int-range",
      "description": "An integer outside signed 64-bit.",
      "format": "aos",
      "text": "#!json\n{\"a\": 9223372036854775808}\n",
      "expect": {
        "error": "integer-range"
      }
    },
    {
      "id": "json-int-max",
      "description": "The largest signed 64-bit integer.",
      "format": "aos",
      "text": "#!json\n{\"a\": 9223372036854775807}\n",
      "expect": {
        "data": {
          "a": 9223372036854775807
        }
      }
    },
    {
      "id": "json-lone-surrogate",
      "description": "A lone surrogate escape is not Unicode.",
      "format": "aos",
      "text": "#!json\n{\"a\": \"\\ud800\"}\n",
      "expect": {
        "error": "invalid-unicode"
      }
    },
    {
      "id": "json-array-top",
      "description": "The top level must be a mapping.",
      "format": "aos",
      "text": "#!json\n[1, 2]\n",
      "expect": {
        "error": "not-a-mapping"
      }
    },
    {
      "id": "toml-datetime",
      "description": "A TOML date has no data model type.",
      "format": "aos",
      "text": "when = 2026-11-04\n",
      "expect": {
        "error": "datetime-value"
      }
    },
    {
      "id": "toml-inf",
      "description": "A non-finite TOML float.",
      "format": "aos",
      "text": "a = inf\n",
      "expect": {
        "error": "non-finite-float"
      }
    },
    {
      "id": "toml-nan",
      "description": "TOML nan.",
      "format": "aos",
      "text": "a = nan\n",
      "expect": {
        "error": "non-finite-float"
      }
    },
    {
      "id": "toml-int-range",
      "description": "A TOML integer outside signed 64-bit.",
      "format": "aos",
      "text": "a = 9223372036854775808\n",
      "expect": {
        "error": [
          "integer-range",
          "parse-error"
        ]
      }
    },
    {
      "id": "yaml-core-strings",
      "description": "YAML 1.2 core schema: yes, on, a date and 1_000 are strings.",
      "format": "aos",
      "text": "#!yaml\na: yes\nb: on\nc: 2026-11-04\nd: 1_000\ne: 'quoted 1'\n",
      "expect": {
        "data": {
          "a": "yes",
          "b": "on",
          "c": "2026-11-04",
          "d": "1_000",
          "e": "quoted 1"
        }
      }
    },
    {
      "id": "yaml-core-numbers",
      "description": "Core-schema integers and floats.",
      "format": "aos",
      "text": "#!yaml\na: 12\nb: 0o17\nc: 0x1F\nd: -3\ne: 1.5\nf: 2e3\ng: true\nh: False\n",
      "expect": {
        "data": {
          "a": 12,
          "b": 15,
          "c": 31,
          "d": -3,
          "e": 1.5,
          "f": 2000.0,
          "g": true,
          "h": false
        }
      }
    },
    {
      "id": "yaml-null-tilde",
      "description": "~ is null.",
      "format": "aos",
      "text": "#!yaml\na: ~\n",
      "expect": {
        "error": "null-value"
      }
    },
    {
      "id": "yaml-null-empty",
      "description": "An empty value is null.",
      "format": "aos",
      "text": "#!yaml\na:\n",
      "expect": {
        "error": "null-value"
      }
    },
    {
      "id": "yaml-inf",
      "description": ".inf is not finite.",
      "format": "aos",
      "text": "#!yaml\na: .inf\n",
      "expect": {
        "error": "non-finite-float"
      }
    },
    {
      "id": "yaml-tag-include",
      "description": "A tag is refused, never applied.",
      "format": "aos",
      "text": "#!yaml\nenv: !include other.yaml\n",
      "expect": {
        "error": "yaml-tag"
      }
    },
    {
      "id": "yaml-tag-python",
      "description": "A language tag is refused.",
      "format": "aos",
      "text": "#!yaml\na: !!python/object/apply:os.system [\"echo\"]\n",
      "expect": {
        "error": "yaml-tag"
      }
    },
    {
      "id": "yaml-tag-core",
      "description": "Even a core tag is refused.",
      "format": "aos",
      "text": "#!yaml\na: !!str 5\n",
      "expect": {
        "error": "yaml-tag"
      }
    },
    {
      "id": "yaml-anchor",
      "description": "Anchors and aliases are refused.",
      "format": "aos",
      "text": "#!yaml\na: &x [1]\nb: *x\n",
      "expect": {
        "error": "yaml-anchor"
      }
    },
    {
      "id": "yaml-merge-key",
      "description": "A merge key is refused.",
      "format": "aos",
      "text": "#!yaml\nbase: {a: 1}\nc:\n  <<: {a: 1}\n",
      "expect": {
        "error": "yaml-merge-key"
      }
    },
    {
      "id": "yaml-two-documents",
      "description": "One document only.",
      "format": "aos",
      "text": "#!yaml\na: 1\n---\nb: 2\n",
      "expect": {
        "error": "parse-error"
      }
    },
    {
      "id": "yaml-int-key",
      "description": "Mapping keys are strings.",
      "format": "aos",
      "text": "#!yaml\n1: x\n",
      "expect": {
        "error": "non-string-key"
      }
    },
    {
      "id": "yaml-duplicate",
      "description": "A duplicate key is refused.",
      "format": "aos",
      "text": "#!yaml\na: 1\na: 2\n",
      "expect": {
        "error": "duplicate-key"
      }
    },
    {
      "id": "static-toml-variables",
      "description": "No interpolation: ${HOME} and {{ x }} are characters.",
      "format": "aos",
      "text": "routing = [\"${HOME}/x\", \"{{ x }}\", \"%(name)s\", \"<ROOT>\"]\n",
      "expect": {
        "data": {
          "routing": [
            "${HOME}/x",
            "{{ x }}",
            "%(name)s",
            "<ROOT>"
          ]
        }
      }
    },
    {
      "id": "static-json-ref",
      "description": "No includes: $ref and include are ordinary keys.",
      "format": "aos",
      "text": "#!json\n{\"$ref\": \"other.json\", \"include\": [\"a.cfg\"]}\n",
      "expect": {
        "data": {
          "$ref": "other.json",
          "include": [
            "a.cfg"
          ]
        }
      }
    },
    {
      "id": "static-yaml-include-key",
      "description": "An include key in YAML is data.",
      "format": "aos",
      "text": "#!yaml\ninclude: other.yaml\nextends: base\n",
      "expect": {
        "data": {
          "include": "other.yaml",
          "extends": "base"
        }
      }
    },
    {
      "id": "bom-after-line",
      "description": "A byte-order mark where the parser's text starts is an error, after a format line too.",
      "format": "aos",
      "text": "#!json\n﻿{\"name\": \"x\"}\n",
      "expect": {
        "error": "parse-error"
      }
    },
    {
      "id": "yaml-directive",
      "description": "A %YAML or %TAG directive is refused: it switches some parsers to YAML 1.1 rules.",
      "format": "aos",
      "text": "#!yaml\n%YAML 1.1\n---\na: yes\n",
      "expect": {
        "error": "yaml-directive"
      }
    },
    {
      "id": "yaml-unicode-line-break",
      "description": "U+2028, U+2029 and U+0085 are refused in YAML: YAML 1.1 and 1.2 parsers split on them differently.",
      "format": "aos",
      "text": "#!yaml\na: one two\n",
      "expect": {
        "error": "parse-error"
      }
    },
    {
      "id": "toml-1-1-inline-newline",
      "description": "A newline inside an inline table (TOML 1.1): refused, or read with TOML 1.1's meaning.",
      "format": "aos",
      "text": "a = { b = 1,\n c = 2 }\n",
      "expect": {
        "data": {
          "a": {
            "b": 1,
            "c": 2
          }
        },
        "error": "parse-error"
      }
    },
    {
      "id": "toml-1-1-escape",
      "description": "The \\e escape (TOML 1.1): refused, or read as ESC.",
      "format": "aos",
      "text": "a = \"\\e[0m\"\n",
      "expect": {
        "data": {
          "a": "\u001b[0m"
        },
        "error": "parse-error"
      }
    },
    {
      "id": "json-u64",
      "description": "The type follows the text: an integer too large for signed 64-bit is refused, never read as a float.",
      "format": "aos",
      "text": "#!json\n{\"x_extension\": 18446744073709551616}\n",
      "expect": {
        "error": "integer-range"
      }
    },
    {
      "id": "depth-limit",
      "description": "Depth counts arrays and mappings; the root is 1.",
      "format": "aos",
      "text": "a = [[[1]]]\n",
      "limits": {
        "max_depth": 3
      },
      "expect": {
        "error": "too-deep"
      }
    },
    {
      "id": "depth-within",
      "description": "The same document at a limit of 4.",
      "format": "aos",
      "text": "a = [[[1]]]\n",
      "limits": {
        "max_depth": 4
      },
      "expect": {
        "data": {
          "a": [
            [
              [
                1
              ]
            ]
          ]
        }
      }
    },
    {
      "id": "size-limit",
      "description": "A document over the size limit.",
      "format": "aos",
      "text": "name = \"0123456789\"\n",
      "limits": {
        "max_bytes": 10
      },
      "expect": {
        "error": "too-large"
      }
    },
    {
      "id": "dotenv-basic",
      "description": "Names, export, quotes removed, everything else literal.",
      "format": "dotenv",
      "text": "A=1\nexport B = two words \nC=\"quoted # not a comment\"\nD='$HOME\\n'\nE=\n# comment\n   # indented comment\n\n",
      "expect": {
        "data": {
          "A": "1",
          "B": "two words",
          "C": "quoted # not a comment",
          "D": "$HOME\\n",
          "E": ""
        }
      }
    },
    {
      "id": "dotenv-crlf-bom",
      "description": "A byte-order mark and CRLF line ends.",
      "format": "dotenv",
      "text": "﻿A=1\r\nB=2\r\n",
      "expect": {
        "data": {
          "A": "1",
          "B": "2"
        }
      }
    },
    {
      "id": "dotenv-unbalanced",
      "description": "Quotes are removed only in matching pairs.",
      "format": "dotenv",
      "text": "A=\"x'\nB='\nC=\"\"\n",
      "expect": {
        "data": {
          "A": "\"x'",
          "B": "'",
          "C": ""
        }
      }
    },
    {
      "id": "dotenv-bad-line",
      "description": "A line that is not NAME=VALUE.",
      "format": "dotenv",
      "text": "A=1\nnot a line\n",
      "expect": {
        "error": "dotenv-syntax"
      }
    },
    {
      "id": "dotenv-duplicate",
      "description": "A name given twice.",
      "format": "dotenv",
      "text": "A=1\nA=2\n",
      "expect": {
        "error": "duplicate-key"
      }
    },
    {
      "id": "dotenv-case-duplicate",
      "description": "Names that differ only in ASCII case are one variable on Windows.",
      "format": "dotenv",
      "text": "a=1\nA=2\n",
      "expect": {
        "error": "duplicate-key"
      }
    },
    {
      "id": "dotenv-bad-name",
      "description": "A name must match [A-Za-z_][A-Za-z0-9_]*.",
      "format": "dotenv",
      "text": "1A=1\n",
      "expect": {
        "error": "dotenv-syntax"
      }
    }
  ]
}
